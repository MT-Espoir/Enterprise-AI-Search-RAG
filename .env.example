# ROOT .env.example 

# ---- Flask ----
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-here

# ---- MongoDB ----
MONGO_URI= your-url
MONGO_DB_NAME= your-db-name

# ---- Google Gemini ----
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_MODEL= your-gemini-model
EMBEDDING_MODEL=text-embedding-004

# ---- Local Stack (Ollama) —
USE_LOCAL_LLM=true                          #Set false to use work well with other modern models.
OLLAMA_BASE_URL=your-url
LOCAL_LLM_MODEL=qwen2.5:3b-instruct         #Can work well with other modern models.
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
RETRIEVAL_STRATEGY=hybrid

# ---- ChromaDB ----
CHROMA_MODE=persistent
CHROMA_PERSIST_PATH=./chromadb_data 
CHROMA_API=your-api-key-here
CHROMA_TENENT=your-tent-key-here
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_database=enterprise_documents

# ---- JWT ----
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# CORS
CORS_ALLOWED_ORIGINS= your-url

# ---- Reranker ----
RERANKER_MODEL=cross-encoder/bge-reranker-v2-m3
RERANKER_TOP_K=5
RETRIEVER_TOP_K=20

# ---- Upload ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,md,txt
UPLOAD_FOLDER=uploads/

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:5000/api
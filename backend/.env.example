# ==============================================================
# .env.example — mẫu cấu hình backend. Copy thành `.env` rồi điền giá trị thật:
#     cp backend/.env.example backend/.env
#
# QUY TẮC: file này KHÔNG BAO GIỜ chứa secret thật (đây là file được commit).
# Mọi khóa/mật khẩu bên dưới đều là placeholder.
#
# Chỉ liệt kê các biến CODE THẬT CÓ ĐỌC. Giá trị ghi ở đây là MẶC ĐỊNH trong
# code (bỏ trống/xóa dòng đi vẫn chạy được), trừ các mục ghi rõ BẮT BUỘC.
# ==============================================================

# ---- Môi trường ----
# development | production | testing. production sẽ BẮT BUỘC có SECRET_KEY/JWT_SECRET_KEY.
FLASK_ENV=development

# ---- Bảo mật (BẮT BUỘC khi FLASK_ENV=production) ----
# Sinh chuỗi ngẫu nhiên: python -c "import secrets; print(secrets.token_hex(32))"
# KHÔNG dùng lại giá trị mẫu dưới đây.
SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu
JWT_SECRET_KEY=thay-bang-chuoi-ngau-nhien-64-ky-tu-khac
JWT_ACCESS_TOKEN_EXPIRES=3600        # giây (1 giờ)
JWT_REFRESH_TOKEN_EXPIRES=2592000    # giây (30 ngày)

# ---- Cơ sở dữ liệu ----
MONGO_URI=mongodb://localhost:27017/rag_db

# ---- Chọn nhà cung cấp LLM sinh câu trả lời ----
# local | gemini | claude | openai
# Nếu bỏ trống sẽ suy ra từ USE_LOCAL_LLM (tương thích ngược): true->local, false->gemini
LLM_PROVIDER=local
USE_LOCAL_LLM=true

# -- local: Ollama chạy trên máy (mặc định, không tốn phí) --
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b-instruct
# LƯU Ý: nếu KHÔNG set, code rơi về "llama3.2:1b" (model cũ, hay từ chối trả lời).

# -- gemini: Google --
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# -- claude: Anthropic --
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# -- openai: MỌI dịch vụ dùng chuẩn API OpenAI --
# Đổi OPENAI_BASE_URL để dùng nhà cung cấp khác mà KHÔNG cần sửa code:
#   ChatGPT  : https://api.openai.com/v1            (model: gpt-4o-mini)
#   DeepSeek : https://api.deepseek.com             (model: deepseek-chat)
#   GLM      : https://open.bigmodel.cn/api/paas/v4 (model: glm-4-plus)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Embedding (LUÔN chạy local, không phụ thuộc API) ----
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-004    # chỉ dùng cho GoogleEmbedder (không dùng ở luồng chính)

# ---- Vector store (ChromaDB) ----
# persistent = file trên đĩa (chỉ an toàn khi chạy 1 worker)
# http       = kết nối Chroma server (BẮT BUỘC khi deploy nhiều worker)
CHROMA_MODE=persistent
CHROMA_PERSIST_PATH=./chromadb_data
CHROMA_HOST=localhost                 # chỉ dùng khi CHROMA_MODE=http
CHROMA_PORT=8000                      # chỉ dùng khi CHROMA_MODE=http
CHROMA_API_KEY=                       # chỉ khi dùng Chroma Cloud
CHROMA_TENANT=
CHROMA_DATABASE=

# ---- Truy hồi (retrieval) ----
RETRIEVAL_STRATEGY=hybrid             # vector | hybrid (hybrid = vector + BM25, hợp nhất RRF)
RETRIEVER_TOP_K=20
HYBRID_VECTOR_POOL_SIZE=20
HYBRID_BM25_POOL_SIZE=20
HYBRID_RRF_K=60

# ---- Xếp hạng lại (ranking) ----
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# ---- Xử lý truy vấn ----
QUERY_PROCESSOR_SLM_ENABLED=true      # dùng model nhỏ để phân loại/viết lại câu hỏi
DECOMPOSITION_ENABLED=true            # tách câu hỏi phức tạp thành câu con

# ---- Guardrails bảo mật (Tier 1) ----
INPUT_GUARDRAILS_ENABLED=true         # chặn prompt injection/jailbreak
RETRIEVAL_GUARDRAILS_ENABLED=true     # lọc nội dung độc hại trong tài liệu
OUTPUT_GUARDRAILS_ENABLED=true        # đối chiếu trích dẫn (chỉ cảnh báo)

# ---- Quan sát vận hành ----
OBSERVABILITY_ENABLED=true            # ghi log JSON + lưu request vào Mongo cho Dashboard

# ---- Ingestion: OCR cho PDF scan ----
OCR_ENABLED=true
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANGUAGES=vie                     # dùng "vie+eng" nếu có cả tài liệu scan tiếng Anh
OCR_DPI=200

# ---- Upload ----
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_SIZE_MB=50

# ---- CORS ----
# Danh sách origin được phép, cách nhau bằng dấu phẩy. Đổi sang domain thật khi deploy.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Redis (cần khi chạy nhiều worker) ----
REDIS_URL=

# ---- Giới hạn tần suất ----
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=                # bỏ trống = dùng REDIS_URL, không có thì memory://
RATELIMIT_LOGIN=5 per minute
RATELIMIT_CHAT=20 per minute
RATELIMIT_UPLOAD=10 per minute

# ---- Đồng bộ nhiều worker (xem README trước khi bật) ----
BM25_SYNC_ENABLED=false               # PHẢI bật ở mọi deploy thật (kể cả 1 worker)
BM25_SYNC_INTERVAL=30                 # giây giữa 2 lần kiểm tra
TRUST_PROXY=false                     # bật khi chạy sau nginx/reverse proxy tin cậy
ALLOW_SINGLE_WORKER_PERSISTENT=false  # cho phép production dùng CHROMA_MODE=persistent

# ---- Chỉ dùng cho benchmark (không ảnh hưởng app) ----
JUDGE_PROVIDER=gemini                 # gemini | claude — model chấm điểm benchmark
# GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5
